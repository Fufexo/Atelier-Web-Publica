# Copia este archivo a .env.local y completa los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Culqi (llaves de integración para desarrollo)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Resend
RESEND_API_KEY=
# Remitente con dominio verificado. Sin esto se usa onboarding@resend.dev,
# que solo entrega al dueño de la cuenta (los clientes no reciben su confirmación).
EMAIL_FROM=
EMAIL_ADMIN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
