# Copia este archivo a .env.local y completa los valores.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Culqi (llaves de integración para desarrollo)
NEXT_PUBLIC_CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=

# Emails de pedido (confirmación al cliente + aviso al admin)
# Opción A — Gmail (gratis): requiere verificación en 2 pasos y una contraseña de
# aplicación creada en https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Opción B — Resend: con onboarding@resend.dev solo entrega al dueño de la cuenta;
# para clientes hay que verificar un dominio y definir EMAIL_FROM.
RESEND_API_KEY=
EMAIL_FROM=
# A quién avisar de cada pedido nuevo
EMAIL_ADMIN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
